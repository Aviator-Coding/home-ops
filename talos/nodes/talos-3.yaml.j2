---
machine:
  type: controlplane
  install:
    disk: /dev/disk/by-id/nvme-WD_BLACK_SN770M_1TB_251211800007
  # Replaces the hostname-NotIn-talos-3 affinity deny-list (2026-09-20 decision,
  # docs/talos-3-scheduling-truth.md section 8): a deny-list fails open (any
  # workload with no nodeAffinity at all can still land here), a taint fails
  # closed (nothing schedules here without an explicit toleration). Every
  # belongs-there workload (the GPU pair, the 2 Ceph OSDs + mon, the CNPG
  # instance, and every DaemonSet whose chart allows it) carries a matching
  # toleration added in the same change - see docs/talos-3-scheduling-truth.md
  # for the full inventory and the two DaemonSets (rbd/cephfs CSI nodeplugin,
  # multus) that could not receive one from this repo.
  #
  # Landing this taint needs `just talos apply-node talos-3` (machine config
  # only - no schematic/kernel change, so `upgrade-node` is not required) run
  # by an operator with a live talosconfig; merging this file alone does not
  # apply it (see talos/AGENTS.md). NoSchedule (not NoExecute) so applying it
  # never evicts anything already running - a should-move pod drains only on
  # its own next reschedule.
  nodeTaints:
    home-operations.com/dedicated: NoSchedule
---
apiVersion: v1alpha1
kind: HostnameConfig
auto: "off"
hostname: talos-3
---
# Alias the two Intel X710 ports (only i40e devices in the system) so the bond
# survives PCIe bus renumbering (pci=assign-busses for the Arc B70 Pro OCuLink switch)
apiVersion: v1alpha1
kind: LinkAliasConfig
name: net%d
selector:
  match: link.driver == "i40e"
---
apiVersion: v1alpha1
kind: BondConfig
name: bond0
links:
  - net0
  - net1
bondMode: 802.3ad
miimon: 100
updelay: 200
downdelay: 200
xmitHashPolicy: layer3+4
lacpRate: fast
mtu: 9000
---
apiVersion: v1alpha1
kind: DHCPv4Config
name: bond0
---
apiVersion: v1alpha1
kind: Layer2VIPConfig
name: 10.10.10.10
link: bond0
---
apiVersion: v1alpha1
kind: VLANConfig
name: bond0.3
vlanID: 3
parent: bond0
mtu: 9000
---
apiVersion: v1alpha1
kind: VLANConfig
name: bond0.90
vlanID: 90
parent: bond0
mtu: 9000
