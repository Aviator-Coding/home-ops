---
machine:
  type: controlplane
  install:
    disk: /dev/disk/by-id/nvme-WD_BLACK_SN770M_1TB_251211800007
  # PreferNoSchedule is a score penalty, not a filter. A hard NoSchedule strands the general fleet on a drain.
  # Takes effect only on apply-node. See skill node-scheduling.
  nodeTaints:
    home-operations.com/dedicated: PreferNoSchedule
---
apiVersion: v1alpha1
kind: HostnameConfig
auto: "off"
hostname: talos-3
---
# Alias the two Intel X710 ports (only i40e devices in the system) so the bond
# survives PCIe bus renumbering (pci=assign-busses for the Arc B70 Pro OCuLink switch)
apiVersion: v1alpha1
kind: LinkAliasConfig
name: net%d
selector:
  match: link.driver == "i40e"
---
apiVersion: v1alpha1
kind: BondConfig
name: bond0
links:
  - net0
  - net1
bondMode: 802.3ad
miimon: 100
updelay: 200
downdelay: 200
xmitHashPolicy: layer3+4
lacpRate: fast
mtu: 9000
---
apiVersion: v1alpha1
kind: DHCPv4Config
name: bond0
---
apiVersion: v1alpha1
kind: Layer2VIPConfig
name: 10.10.10.10
link: bond0
---
apiVersion: v1alpha1
kind: VLANConfig
name: bond0.3
vlanID: 3
parent: bond0
mtu: 9000
---
apiVersion: v1alpha1
kind: VLANConfig
name: bond0.90
vlanID: 90
parent: bond0
mtu: 9000
