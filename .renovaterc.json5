{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  dependencyDashboard: true,
  // Platform automerge would merge on Labeler alone, before flate, Image Pull and validate finish. Skill `renovate`.
  platformAutomerge: false,
  // auto rebases every automerge PR each time main moves, which restarts CI, so a run never sees green checks and never merges.
  // main does not require up-to-date branches (ruleset strict_required_status_checks_policy false). Skill `renovate`.
  rebaseWhen: "conflicted",
  extends: [
    // Community base, pinned to a tag so an upstream push cannot change merge behaviour unreviewed. Bump the tag deliberately. Skill `renovate`.
    "github>home-operations/renovate-presets#11.0.0",
    // The base sets no timezone; schedules (rsshub) have always run on America/New_York.
    ":timezone(America/New_York)",
    ":enablePreCommit",
    "github>skrumbach/home-ops//.renovate/autoMerge.json5",
    "github>skrumbach/home-ops//.renovate/customManagers.json5",
    "github>skrumbach/home-ops//.renovate/grafanaDashboards.json5",
    "github>skrumbach/home-ops//.renovate/groups.json5",
    "github>skrumbach/home-ops//.renovate/labels.json5",
    "github>skrumbach/home-ops//.renovate/overrides.json5",
    "github>skrumbach/home-ops//.renovate/talos.json5",
    // The base extends :automergeBranch, but renovate/** pushes get no status check, so branch automerge never merges. Every automerge rule in autoMerge.json5 sets automergeType "pr". Skill `renovate`.
  ],
  // The base extends :disableRateLimiting. Without a cap a config fix can release a whole backlog of automerging PRs in one pass.
  prHourlyLimit: 10,
  prConcurrentLimit: 20,
  // GHCR/quay publish no release timestamp, so the minor and LiteLLM rules set minimumReleaseAgeBehaviour
  // timestamp-optional on purpose. Renovate warns on every run that takes that path; it is policy, not a fault.
  logLevelRemap: [
    {
      matchMessage: "/^Some release\\(s\\) did not have a releaseTimestamp/",
      newLogLevel: "info",
    },
  ],
  // The base preset's annotated-dependency manager scans every file; docs and CI tests quote the syntax as examples.
  ignorePaths: [
    "**/resources/**",
    "**/*.md",
    "scripts/ci/**",
  ],
  flux: {
    managerFilePatterns: [
      "/(^|/)kubernetes/.+\\.ya?ml$/"
    ]
  },
  "helm-values": {
    managerFilePatterns: [
      "/(^|/)kubernetes/.+\\.ya?ml$/"
    ]
  },
  kubernetes: {
    managerFilePatterns: [
      "/(^|/)kubernetes/.+\\.ya?ml$/"
    ]
  },
  helmfile: {
    managerFilePatterns: [
      "/(^|/)bootstrap/.+\\.ya?ml$/"
    ]
  },
}
