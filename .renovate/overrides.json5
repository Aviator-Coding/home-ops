{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      // Floor >=1.93.0 or classifier_type llm is ignored. Skill `litellm-proxy` references/auto-router.md.
      description: "LiteLLM plain vX.Y.Z tags; floor >=1.93.0 for LLM classifier",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/berriai/litellm-non_root"],
      versioning: "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      allowedVersions: ">=1.93.0",
    },
    {
      description: "Override Helmfile Dependency Name",
      matchDatasources: ["docker"],
      matchManagers: ["helmfile"],
      overrideDepName: "{{packageName}}",
    },
    {
      // No GitHub repo. Resolve via docker 1password/op with semver, or a -beta tag ranks as stable. Skill `renovate` references/versioning-traps.md.
      description: "1Password CLI has no GitHub repo; resolve via the official docker image",
      matchManagers: ["mise"],
      matchDepNames: ["1password-cli"],
      overrideDatasource: "docker",
      overridePackageName: "1password/op",
      versioning: "semver",
    },
    {
      description: "Override Talos Installer Package Name",
      matchDatasources: ["docker"],
      matchPackageNames: ["/factory\\.talos\\.dev/"],
      overridePackageName: "ghcr.io/siderolabs/installer",
    },
    {
      // 2.3.x drops EMQX OSS 5.8.x support (calls Enterprise-only
      // load_rebalance API -> readiness gate stuck -> MQTT down).
      // See emqx/emqx-operator#1202. Stay on the 2.2.x line.
      description: "Pin EMQX operator to 2.2.x (Open-Source broker compat)",
      matchPackageNames: ["emqx-operator", "ghcr.io/emqx/emqx-operator"],
      allowedVersions: "<2.3.0",
    },
    {
      // EMQX Open-Source ended at 5.8.x; 5.9/5.10/6.x are Enterprise-only.
      description: "Keep EMQX broker on Open-Source 5.8.x",
      matchDatasources: ["docker"],
      matchPackageNames: ["public.ecr.aws/emqx/emqx"],
      allowedVersions: "<5.9.0",
    },
    {
      // Negated regex excludes exactly v1.13.3 (PR #867). A bare <X.Y.Z ceiling goes silent once the tracked value passes it. This rule proposes; automerge is the separate rule in autoMerge.json5. Skill `renovate` references/versioning-traps.md.
      description: "Exclude Talos v1.13.3 only (permanent upgrade failure on talos-1, see #867) - not a version ceiling",
      matchPackageNames: [
        "ghcr.io/siderolabs/installer",
        "ghcr.io/siderolabs/talosctl",
        "siderolabs/talos",
        "/factory\\.talos\\.dev/",
      ],
      allowedVersions: "!/^v?1\\.13\\.3$/",
    },
    {
      // Same OCI repo publishes a v2 kgateway lineage. Stay on standalone 1.x. Skill `renovate` references/versioning-traps.md.
      description: "Pin agentgateway to the standalone 1.x lineage (<2.0.0)",
      matchPackageNames: [
        "ghcr.io/agentgateway/charts/agentgateway",
        "ghcr.io/agentgateway/charts/agentgateway-crds",
        // Keep the old host so any leftover refs still get the lineage pin.
        "cr.agentgateway.dev/charts/agentgateway",
        "cr.agentgateway.dev/charts/agentgateway-crds",
      ],
      allowedVersions: "<2.0.0",
    },
    {
      // Provider is generated from the server OpenAPI schema. Bump it with the server tag. automerge stays false. Skill `renovate` references/versioning-traps.md.
      description: "Keep the Authentik OpenTofu provider aligned with the server release line",
      matchDatasources: ["terraform-provider"],
      matchPackageNames: ["goauthentik/authentik"],
      automerge: false,
    },
    {
      // Ceph versioning: x.0.z = development, x.1.z = RC, x.2.z = stable.
      // Renovate matches registry tags, not docs.ceph.com/en/latest/releases/,
      // so RCs like v21.1.0 (no official v21 release) get proposed as upgrades
      // (#1396). Restrict to stable tags only. Do not apply this to
      // ghcr.io/rook/ceph - Rook versions as ordinary semver.
      description: "Keep quay.io/ceph/ceph on stable x.2.z tags (skip x.0.z dev and x.1.z RC)",
      matchDatasources: ["docker"],
      matchPackageNames: ["quay.io/ceph/ceph"],
      allowedVersions: "/^v?\\d+\\.2\\.\\d+$/",
    },
    {
      // Docker compatibility treats the per-release hash as a qualifier, so leave it uncaptured. Do not name the group compatibility. Skill `renovate` references/versioning-traps.md.
      description: "Plex uses X.Y.Z.BUILD-HASH tags; regex-version them so Renovate can see updates past the per-release commit hash",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/plexinc/pms-docker"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-[a-f0-9]+$",
    },
  ],
}
