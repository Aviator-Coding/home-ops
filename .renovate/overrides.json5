{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      // Upstream dropped main-vX.Y.Z-stable after v1.81.x; tags are plain vX.Y.Z.
      // Floor at v1.93.0: below that classifier_type: llm is silently ignored
      // (ComplexityRouterConfig extra="allow") and the router falls back to the
      // 25%-accurate rule-based scorer. See docs/ai-system/litellm/auto-router.md.
      description: "LiteLLM plain vX.Y.Z tags; floor >=1.93.0 for LLM classifier",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/berriai/litellm-non_root"],
      versioning: "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      allowedVersions: ">=1.93.0",
    },
    {
      description: "Override Helmfile Dependency Name",
      matchDatasources: ["docker"],
      matchManagers: ["helmfile"],
      overrideDepName: "{{packageName}}",
    },
    {
      description: "Override Talos Installer Package Name",
      matchDatasources: ["docker"],
      matchPackageNames: ["/factory\\.talos\\.dev/"],
      overridePackageName: "ghcr.io/siderolabs/installer",
    },
    {
      // 2.3.x drops EMQX OSS 5.8.x support (calls Enterprise-only
      // load_rebalance API -> readiness gate stuck -> MQTT down).
      // See emqx/emqx-operator#1202. Stay on the 2.2.x line.
      description: "Pin EMQX operator to 2.2.x (Open-Source broker compat)",
      matchPackageNames: ["emqx-operator", "ghcr.io/emqx/emqx-operator"],
      allowedVersions: "<2.3.0",
    },
    {
      // EMQX Open-Source ended at 5.8.x; 5.9/5.10/6.x are Enterprise-only.
      description: "Keep EMQX broker on Open-Source 5.8.x",
      matchDatasources: ["docker"],
      matchPackageNames: ["public.ecr.aws/emqx/emqx"],
      allowedVersions: "<5.9.0",
    },
    {
      // v1.13.3 upgrade failed permanently on talos-1 (tuppr TalosUpgrade
      // stuck Failed, nodes stranded on v1.12.6). Pinned to v1.13.2 in #867.
      // "ghcr.io/siderolabs/talosctl" (the CLI image used by
      // .github/docker/talosctl-busybox/Dockerfile) was missing from
      // matchPackageNames, so this pin never actually caught it: five PRs
      // (#1023-#1291) already carried it to v1.13.8 unblocked, and a sixth
      // (v1.13.9) was sitting on an open Renovate branch. Added below to
      // close the gap.
      //
      // DO NOT go back to a `<1.13.3` (or any bare `<X.Y.Z`) ceiling here.
      // That form reads as "block only 1.13.3" but actually blocks every
      // version above it too: once the tracked value passes the ceiling
      // (it did - all four matched deps sit at v1.13.8/v1.13.9 today),
      // there is no candidate simultaneously greater than current and less
      // than the ceiling, so Renovate silently proposes NOTHING for Talos
      // - not v1.13.10, not v1.14.x, nothing. This sat unnoticed for
      // months: zero open/recent Renovate Talos PRs, and
      // .github/docker/talosctl-busybox/Dockerfile stuck at v1.13.8 while
      // the cluster ran v1.13.9. Root-cause and decision record:
      // data/homeops-talos-pin-root-cause/report.md and
      // data/decisions-2026-08-31/talos-1133-pin-scope.md (firstmate-local,
      // not in this repo).
      //
      // All three contributing causes of the original failure are
      // independently resolved: the upstream k8s.RenderConfigsStaticPodController
      // "cannot deep copy int" panic is fixed in Talos v1.13.4+
      // (siderolabs/talos#13445/#13454, commit 5ed296b76); talos-1's faulty
      // DDR5 SODIMM that caused the underlying instability was RMA'd
      // (closed 2026-08-21, see docs/hardware-incidents.md); and tuppr's
      // reboot-vs-terminal-failure misclassification and status-truthfulness
      // bugs are fixed between the chart version live at the incident
      // (0.1.36) and today's deployed 0.5.0. So the exclusion below exists
      // purely as institutional memory - v1.13.3 itself has never been
      // retried since the one attempt that failed (the cluster jumped
      // v1.13.2 -> v1.13.9 directly in PR #1383, skipping it) - not as an
      // active guard against a live, unfixed defect.
      //
      // Negated-regex form excludes exactly v1.13.3 and nothing else, and
      // keeps working regardless of how far the tracked value moves past
      // it. Renovate's regex allowedVersions is a plain RegExp.test against
      // each release's raw, unnormalized version string (matches
      // getRegexPredicate/filterVersions in Renovate's own source - verified
      // against the installed renovate@44.52.1 package, not just the docs).
      // `v?` covers both prefix styles: verified live 2026-08-31 that all
      // three real registries behind these four matchPackageNames
      // (ghcr.io/siderolabs/installer, ghcr.io/siderolabs/talosctl, and the
      // factory.talos.dev-backed "siderolabs/talos" custom datasource) only
      // ever publish "v"-prefixed tags (e.g. "v1.13.3", never bare
      // "1.13.3") - but the four matched packages don't all share one
      // extraction path, so the pattern stays defensive rather than
      // assuming that holds forever.
      //
      // This rule only controls which versions Renovate is allowed to
      // PROPOSE - it says nothing about auto-merge. See the matching "Never
      // auto merge Talos" rule in .renovate/autoMerge.json5: unfreezing
      // proposals here also exposes that ghcr.io/siderolabs/installer and
      // ghcr.io/siderolabs/talosctl use the "docker" versioning scheme,
      // whose isStable() does not treat Talos's "-alpha.N"/"-beta.N"/
      // "-rc.N" suffixes as unstable (verified against installed
      // renovate@44.52.1) - so ignoreUnstable alone would NOT have kept a
      // prerelease (a real one, v1.14.0-alpha.0, is live on the registry
      // today) out of the repo-wide "auto merge minor updates" rule. That
      // autoMerge.json5 entry blocks automerge for all four packages here,
      // not just prereleases, because any Talos bump - stable or not -
      // triggers tuppr's live, unattended, powercycle node reboot and must
      // stay an attended captain operation regardless of update type.
      description: "Exclude Talos v1.13.3 only (permanent upgrade failure on talos-1, see #867) - not a version ceiling",
      matchPackageNames: [
        "ghcr.io/siderolabs/installer",
        "ghcr.io/siderolabs/talosctl",
        "siderolabs/talos",
        "/factory\\.talos\\.dev/",
      ],
      allowedVersions: "!/^v?1\\.13\\.3$/",
    },
    {
      // This registry hosts TWO distinct lineages under the same repo, and
      // Renovate's OCI datasource picks the numerically-highest tag across both:
      //   - standalone agentgateway (1.x, agentgateway.dev/v1alpha1 CRDs) -> what we run
      //   - kgateway-bundled distribution (v2.2.x) -> different control plane,
      //     namespace agentgateway-system, requires a full TrafficPolicy migration.
      // The v2.2.x bump (#946/#947) would swap out the whole gateway. Stay on the
      // standalone 1.x line (latest v1.3.0); upgrade across lineages by hand only.
      description: "Pin agentgateway to the standalone 1.x lineage (<2.0.0)",
      matchPackageNames: [
        "ghcr.io/agentgateway/charts/agentgateway",
        "ghcr.io/agentgateway/charts/agentgateway-crds",
        // Keep the old host so any leftover refs still get the lineage pin.
        "cr.agentgateway.dev/charts/agentgateway",
        "cr.agentgateway.dev/charts/agentgateway-crds",
      ],
      allowedVersions: "<2.0.0",
    },
    {
      // The `goauthentik/authentik` OpenTofu provider is generated from the
      // Authentik SERVER's OpenAPI schema, so the two are coupled: a provider
      // ahead of the running server can send fields the API rejects, and a
      // provider behind it silently cannot express newer ones. The server tag
      // lives in kubernetes/apps/base/security/authentik/app/helmrelease.yaml
      // (OCIRepository `ref.tag`); the provider is pinned to the matching release
      // line in terraform/authentik/main.tofu. Bump them in the same change.
      //
      // Nothing in .renovate/autoMerge.json5 matches the `terraform-provider`
      // datasource today, so these already arrive as reviewable PRs. This entry
      // states the coupling and keeps it true if those rules ever widen - an
      // auto-merged provider bump here lands untested against the live SSO stack.
      description: "Keep the Authentik OpenTofu provider aligned with the server release line",
      matchDatasources: ["terraform-provider"],
      matchPackageNames: ["goauthentik/authentik"],
      automerge: false,
    },
    {
      // Ceph versioning: x.0.z = development, x.1.z = RC, x.2.z = stable.
      // Renovate matches registry tags, not docs.ceph.com/en/latest/releases/,
      // so RCs like v21.1.0 (no official v21 release) get proposed as upgrades
      // (#1396). Restrict to stable tags only. Do not apply this to
      // ghcr.io/rook/ceph - Rook versions as ordinary semver.
      description: "Keep quay.io/ceph/ceph on stable x.2.z tags (skip x.0.z dev and x.1.z RC)",
      matchDatasources: ["docker"],
      matchPackageNames: ["quay.io/ceph/ceph"],
      allowedVersions: "/^v?\\d+\\.2\\.\\d+$/",
    },
  ],
}
