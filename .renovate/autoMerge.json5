{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      // automergeType stays at the default "pr". Skill `renovate`.
      description: "Auto merge all container digest updates",
      matchDatasources: ["docker"],
      automerge: true,
      matchUpdateTypes: ["digest"],
      ignoreTests: false,
    },
    {
      description: "Auto merge all container and helm patch updates",
      matchDatasources: ["docker", "helm", "github-releases", "github-tags"],
      automerge: true,
      matchUpdateTypes: ["patch"],
      ignoreTests: false,
    },
    {
      description: "Auto merge all container and helm minor updates",
      matchDatasources: ["docker", "helm", "github-releases", "github-tags"],
      automerge: true,
      matchUpdateTypes: ["minor"],
      minimumReleaseAge: "3 days",
      ignoreTests: false,
    },
    {
      // MUST stay after the three blanket automerge rules. Path match, not package name: a chart self-update must stay a reviewed PR. Skill `renovate`.
      description: "Never auto merge Renovate's own chart/image - self-update must be reviewed",
      matchFileNames: ["kubernetes/apps/base/renovate/**"],
      automerge: false,
    },
    {
      // MUST stay after the three blanket automerge rules. Skill `renovate`.
      description: "Never auto merge kopiur - it is the backup system on an alpha API",
      matchPackageNames: [
        "ghcr.io/home-operations/charts/kopiur",
        "ghcr.io/home-operations/kopiur-controller",
        "ghcr.io/home-operations/kopiur-webhook",
        "ghcr.io/home-operations/kopiur-mover",
        "home-operations/kopiur",
      ],
      // Proposals stay PRs. An unattended CRD change can refuse every backup. Read upstream upgrade notes before taking one. Skill `renovate`.
      automerge: false,
    },
    {
      // MUST stay after the three blanket automerge rules. A merge of talosupgrade.yaml powercycles nodes, and docker isStable treats -alpha as a minor. Skill `renovate` references/versioning-traps.md.
      description: "Never auto merge Talos - node upgrades are attended captain operations, and ghcr.io/siderolabs/installer's docker versioning does not treat -alpha/-beta/-rc suffixes as unstable",
      matchPackageNames: [
        "ghcr.io/siderolabs/installer",
        "ghcr.io/siderolabs/talosctl",
        "siderolabs/talos",
        "/factory\\.talos\\.dev/",
      ],
      automerge: false,
    },
    {
      // MUST stay after the blanket rules. kubelet feeds KubernetesUpgrade, which upgrades the live cluster with no human apply step. Skill `renovate`.
      description: "Never auto merge Kubernetes control-plane/kubelet - kubelet feeds tuppr's KubernetesUpgrade CR, which upgrades the live cluster with no human apply step",
      matchPackageNames: [
        "ghcr.io/siderolabs/kubelet",
        "registry.k8s.io/kube-apiserver",
        "registry.k8s.io/kube-controller-manager",
        "registry.k8s.io/kube-proxy",
        "registry.k8s.io/kube-scheduler",
      ],
      automerge: false,
    },
    {
      // MUST stay after the blanket minor rule. GHCR has no releaseTimestamp, so timestamp-optional is what opens the PR. automerge stays false. Do not widen this. Skill `renovate` references/versioning-traps.md.
      description: "LiteLLM proxy: GHCR has no release timestamp, so open minor PRs but never automerge them",
      matchPackageNames: ["ghcr.io/berriai/litellm-non_root"],
      minimumReleaseAgeBehaviour: "timestamp-optional",
      automerge: false,
    },
    {
      // MUST stay after the blanket digest rule. automerge stays true; the schedule only throttles the rolling latest tag to once a week, UTC. Skill `renovate`.
      description: "rsshub tracks a rolling `latest` tag that rebuilds many times a day - limit its digest updates to once a week instead of every rebuild",
      matchPackageNames: ["ghcr.io/diygod/rsshub"],
      matchUpdateTypes: ["digest"],
      schedule: ["before 6am on monday"],
    },
  ],
}
