{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  customDatasources: {
    "talos-factory": {
      defaultRegistryUrlTemplate: "https://factory.talos.dev/versions",
      format: "json",
      transformTemplates: ['{"releases": [$.{"version": $}]}'],
    },
  },
  customManagers: [
    {
      description: "Talos Factory installer image (schematic id is templated, so match only the tag)",
      customType: "regex",
      managerFilePatterns: ["/(^|/)talos/.+\\.ya?ml(?:\\.j2)?$/"],
      matchStrings: ["factory\\.talos\\.dev/[^:]+:(?<currentValue>v\\d\\S*)"],
      datasourceTemplate: "custom.talos-factory",
      depNameTemplate: "siderolabs/talos",
      versioningTemplate: "semver",
    },
    {
      description: "Annotated container images in Talos machine config templates",
      customType: "regex",
      managerFilePatterns: ["/(^|/)talos/.+\\.ya?ml(?:\\.j2)?$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*image:\\s*\\S+:(?<currentValue>[^\\s@]+)",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}docker{{/if}}",
    },
  ],
  packageRules: [
    {
      // The base preset points the kubernetes manager at every *.yaml(.j2); the regex managers above own talos/, so a second extraction would only duplicate them.
      description: "Talos templates are owned by the regex managers in this file, not the kubernetes manager",
      matchManagers: ["kubernetes"],
      matchFileNames: ["talos/**"],
      enabled: false,
    },
  ],
}
