{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/auto",
  "compaction": {
    "auto": true,
    "prune": true,
    "preserve_recent_tokens": 20000,
    "reserved": 16384
  },
  "tool_output": {
    "max_lines": 800,
    "max_bytes": 16384
  },
  "enabled_providers": [
    "litellm"
  ],
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "http://litellm.ai.svc.cluster.local:4000/v1",
        "apiKey": "{env:LITELLM_API_KEY}",
        "timeout": 1800000
      },
      "models": {
        "auto": {
          "name": "Auto (complexity router)",
          "limit": {
            "context": 140000,
            "output": 16384
          }
        },
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6-35B-A3B (local)",
          "limit": {
            "context": 140000,
            "output": 16384
          }
        },
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5",
          "limit": {
            "context": 200000,
            "output": 64000
          }
        },
        "claude-opus-5": {
          "name": "Claude Opus 5",
          "limit": {
            "context": 200000,
            "output": 32000
          }
        }
      }
    }
  },
  "mcp": {
    "toolhive": {
      "type": "remote",
      "url": "http://vmcp-mcp-gateway-internal.ai.svc.cluster.local:4483/mcp",
      "enabled": true
    }
  }
}
