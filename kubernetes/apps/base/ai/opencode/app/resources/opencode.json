{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/auto",
  "compaction": {
    "auto": true,
    "prune": true,
    "preserve_recent_tokens": 20000,
    "reserved": 16384
  },
  "tool_output": {
    "max_lines": 800,
    "max_bytes": 16384
  },
  "enabled_providers": [
    "litellm",
    "litellm-projects"
  ],
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "http://litellm.ai.svc.cluster.local:4000/v1",
        "apiKey": "{env:LITELLM_API_KEY}",
        "timeout": 1800000
      },
      "models": {
        "auto": {
          "name": "Auto (complexity router)",
          "limit": {
            "context": 140000,
            "output": 16384
          }
        }
      }
    },
    "litellm-projects": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM projects",
      "options": {
        "baseURL": "http://litellm.ai.svc.cluster.local:4000/v1",
        "apiKey": "{env:LITELLM_PROJECTS_API_KEY}",
        "timeout": 1800000
      },
      "models": {
        "claude-fable-5": {
          "name": "claude-fable-5",
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "claude-fable-5-1-metered": {
