+def _epoch(value) -> Optional[int]:
+    """Unix seconds for a timestamp column read through `db.query_raw`.
+
+    Prisma's raw queries return `timestamp` columns as ISO-8601 strings, not
+    datetime objects, so calling `.timestamp()` on them raised AttributeError
+    and 500'd create/list for any store whose last_active_at was set (i.e. after
+    the first ingest). Naive values are UTC, matching the server's NOW().
+    """
+    if not value:
+        return None
+    if isinstance(value, str):
+        value = datetime.fromisoformat(value.replace("Z", "+00:00"))
+    if value.tzinfo is None:
+        value = value.replace(tzinfo=timezone.utc)
+    return int(value.timestamp())
+
