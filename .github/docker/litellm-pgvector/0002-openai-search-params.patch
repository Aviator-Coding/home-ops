+def _metadata_equalities(filters: dict) -> dict:
+    """Flatten a search `filters` object to {metadata key: required value}.
+
+    Accepts this server's own flat form ({"category": "support"}) and the
+    OpenAI Vector Stores form LiteLLM forwards: a comparison filter
+    {"type": "eq", "key": ..., "value": ...} or an {"type": "and", "filters":
+    [...]} of them. Upstream read the OpenAI form as literal metadata keys
+    ("type", "key", "value") and silently matched nothing; any other operator
+    is now a 400 instead of an empty result.
+    """
+    kind = filters.get("type")
+    if kind is None:
+        return filters
+    if kind == "eq" and "key" in filters:
+        return {filters["key"]: filters.get("value")}
+    if kind == "and" and isinstance(filters.get("filters"), list):
+        merged = {}
+        for sub in filters["filters"]:
+            merged.update(_metadata_equalities(sub))
+        return merged
+    raise HTTPException(
+        status_code=400,
+        detail=f"Unsupported filter {kind!r}: only 'eq' comparisons, optionally combined with 'and', are supported",
+    )
+
